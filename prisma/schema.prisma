generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Platform {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  slug      String       @unique
  type      PlatformType @default(GAME)
  createdAt DateTime     @default(now())
  image     String?
  updatedAt DateTime     @updatedAt
  rewards   Reward[]
}

model Reward {
  id           Int              @id @default(autoincrement())
  title        String
  description  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  platformId   Int
  previewImage String?
  slug         String
  status       RewardStatus     @default(active)
  claimUrl     String?
  expiresAt    DateTime?
  image        String?
  translations Json?
  platform     Platform         @relation(fields: [platformId], references: [id], onDelete: Cascade)
  contents     RewardContent[]
  reactions    RewardReaction[]
  reports      RewardReport[]

  @@unique([platformId, slug])
  @@index([platformId])
  @@index([status])
}

model RewardContent {
  id           Int               @id @default(autoincrement())
  type         RewardContentType
  value        String?
  href         String?
  label        String?
  imageSrc     String?
  imageAlt     String?
  rewardId     Int
  order        Int
  createdAt    DateTime          @default(now())
  translations Json?
  reward       Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([rewardId])
}

model RewardReaction {
  id           Int          @id @default(autoincrement())
  reactionType ReactionType
  visitorId    String
  rewardId     Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reward       Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, visitorId])
  @@index([rewardId, reactionType])
}

model RewardReport {
  id         Int        @id @default(autoincrement())
  reportType ReportType
  visitorId  String
  reportDay  DateTime
  rewardId   Int
  createdAt  DateTime   @default(now())
  note       String?
  reward     Reward     @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, visitorId, reportDay])
  @@index([rewardId, reportType])
  @@index([rewardId, createdAt])
}

enum PlatformType {
  GAME
  SERVICE
}

enum RewardStatus {
  active
  expired
}

enum RewardContentType {
  text
  image
  link
  code
}

enum ReactionType {
  love
  dislike
}

enum ReportType {
  expired
  not_working
  other
}
