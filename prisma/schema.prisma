generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformType {
  GAME
  SERVICE
}

enum RewardStatus {
  active
  expired
}

enum RewardContentType {
  text
  image
  link
  code
}

enum ReactionType {
  love
  dislike
}

enum ReportType {
  expired
  not_working
  other
}

model Platform {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  slug    String       @unique
  image   String?
  type    PlatformType @default(GAME)
  rewards Reward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reward {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  title        String
  description  String
  previewImage String?      // Image shown in listings
  image        String?      // Reward detail image (from admin)
  claimUrl     String?
  expiresAt    DateTime?
  status       RewardStatus @default(active)
  translations Json?        // stores localized title and description e.g. { es: { title: "...", description: "..." }, ar: { ... } }

  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  platformId Int

  contents RewardContent[]
  reactions RewardReaction[]
  reports   RewardReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId])
  @@index([status])
}

model RewardContent {
  id   Int               @id @default(autoincrement())
  type RewardContentType

  value    String? // for text
  href     String? // for link
  label    String? // for link label
  imageSrc String? // for image
  imageAlt String?
  translations Json? // stores localized value, label, and alt e.g. { es: { value: "...", label: "..." }, ar: { ... } }

  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId Int

  order Int // controls rendering order

  createdAt DateTime @default(now())

  @@index([rewardId])
}

model RewardReaction {
  id           Int          @id @default(autoincrement())
  reactionType ReactionType
  visitorId    String

  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rewardId, visitorId])
  @@index([rewardId, reactionType])
}

model RewardReport {
  id         Int        @id @default(autoincrement())
  reportType ReportType
  visitorId  String
  reportDay  DateTime
  note       String?

  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId Int

  createdAt DateTime @default(now())

  @@unique([rewardId, visitorId, reportDay])
  @@index([rewardId, reportType])
  @@index([rewardId, createdAt])
}
