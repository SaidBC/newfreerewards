generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model Platform {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String       @unique
  slug      String       @unique
  type      PlatformType @default(GAME)
  createdAt DateTime     @default(now())
  image     String?
  updatedAt DateTime     @updatedAt
  rewards   Reward[]
}

model Reward {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  platformId   String           @db.ObjectId
  previewImage String?
  slug         String
  status       RewardStatus     @default(active)
  complexity   RewardComplexity @default(SIMPLE)
  template     RewardTemplate   @default(NONE)
  claimUrl     String?
  expiresAt    DateTime?
  image        String?
  translations Json?
  platform     Platform         @relation(fields: [platformId], references: [id], onDelete: Cascade)
  contents     RewardContent[]
  reactions    RewardReaction[]
  reports      RewardReport[]

  @@unique([platformId, slug])
  @@index([platformId])
  @@index([status])
  @@index([complexity])
  @@index([template])
}

model ScanResult {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  status         ScanStatus @default(PENDING)
  sourceUrls     String[]
  platformSlug   String?
  summary        Json?
  missingRewards Json?
  expiredRewards Json?
  matches        Json?
  rawOutput      Json?
  error          String?
  apiKeyName     String?
  startedAt      DateTime   @default(now())
  completedAt    DateTime?
  createdAt      DateTime   @default(now())

  @@index([status])
  @@index([createdAt])
}

model RewardContent {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  type         RewardContentType
  value        String?
  href         String?
  label        String?
  imageSrc     String?
  imageAlt     String?
  rewardId     String            @db.ObjectId
  order        Int
  createdAt    DateTime          @default(now())
  translations Json?
  reward       Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([rewardId])
}

model RewardReaction {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  reactionType ReactionType
  visitorId    String
  rewardId     String       @db.ObjectId
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reward       Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, visitorId])
  @@index([rewardId, reactionType])
}

model RewardReport {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  reportType ReportType
  visitorId  String
  reportDay  DateTime
  rewardId   String     @db.ObjectId
  createdAt  DateTime   @default(now())
  note       String?
  reward     Reward     @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, visitorId, reportDay])
  @@index([rewardId, reportType])
  @@index([rewardId, createdAt])
}

enum PlatformType {
  GAME
  SERVICE
}

enum RewardStatus {
  active
  expired
}

enum RewardComplexity {
  SIMPLE
  COMPLEX
}

enum RewardTemplate {
  NONE
  SUPERCELL_CODE
  QR_CODE
}

enum ScanStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RewardContentType {
  text
  image
  link
  code
  title
  list
  italic
  qr
}

enum ReactionType {
  love
  dislike
}

enum ReportType {
  expired
  not_working
  other
}
